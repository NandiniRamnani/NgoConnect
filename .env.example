# Template for the .env file. Copy it, then fill in real values:
#     cp .env.example .env          (PowerShell: Copy-Item .env.example .env)
# .env is gitignored; this file is safe to commit because it holds no real secrets.

# ── MongoDB Atlas ────────────────────────────────────────────────────────────
# Atlas -> Connect -> Drivers. Remember to URL-encode any special characters in the
# password, and to put the database name (backend) before the "?".
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/backend?appName=Cluster0

# ── Admin portal login (http://localhost:5173/admin) ─────────────────────────
# Leave both blank to disable the built-in admin account entirely.
NGO_ADMIN_USERNAME=admin@example.com
NGO_ADMIN_PASSWORD=change-me

# ── Cloudinary ───────────────────────────────────────────────────────────────
# cloudinary.com -> Dashboard -> Product Environment Credentials.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── Razorpay (test mode) ─────────────────────────────────────────────────────
# dashboard.razorpay.com -> Test Mode -> Settings -> API Keys -> Generate Test Key.
# The key id reaches the browser; the secret must never leave the backend.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-key-secret

# Settings -> Webhooks -> Add New Webhook. Point it at
#     https://<your-public-host>/api/payments/webhook
# subscribe to the `payment.captured` event, and paste the secret you set there below.
# This is NOT the key secret above. Leave blank and the webhook endpoint refuses every call.
# For local testing, expose port 8082 with a tunnel (e.g. `ngrok http 8082`) and use that URL.
RAZORPAY_WEBHOOK_SECRET=

# ── Gmail SMTP for password-reset emails ─────────────────────────────────────
# App Password (16 chars) from https://myaccount.google.com/apppasswords —
# requires 2-Step Verification. NOT your normal Gmail password.
MAIL_USERNAME=your-project-address@gmail.com
MAIL_PASSWORD=PASTE_16_CHAR_APP_PASSWORD_HERE

# ── Frontend base URL, used to build links inside reset emails ───────────────
APP_FRONTEND_URL=http://localhost:5173

# Minutes a password-reset link stays valid. Kept short on purpose — see application.properties.
RESET_TOKEN_MINUTES=15

# ── NGO payouts ──────────────────────────────────────────────────────────────
# Hours a donation waits in `clearing` before an NGO can withdraw it (Razorpay settles T+2).
# Set to 0 to make funds withdrawable immediately when demonstrating the flow.
PAYOUT_CLEARING_HOURS=48
# Hours withdrawals stay frozen after payout details are changed.
PAYOUT_COOLING_OFF_HOURS=24
# Smallest single withdrawal, in rupees.
PAYOUT_MIN_RUPEES=100
# Where "new withdrawal request" emails go. Blank disables them.
PAYOUT_ADMIN_EMAIL=
